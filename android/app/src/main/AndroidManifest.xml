<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Compatibilité Android TV ──────────────────────────────────────────── -->
    <!-- Déclare la compatibilité Leanback (Android TV) sans l'exiger          -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- L'écran tactile n'est pas obligatoire → permet l'installation sur TV  -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Permissions réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Accès aux vidéos -->
    <!-- Android 13+ -->
    <!--uses-permission android:name="android.permission.READ_MEDIA_VIDEO" /-->
    <!-- Android 14+ : permet à l'utilisateur de choisir les fichiers à partager -->
    <!--uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" /-->

    <!-- Compatibilité Android 10–12 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>


    <!-- Pour Android 13 (API 33) et supérieur.
    Cette permission est requise pour accéder aux vidéos dans le stockage partagé. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Téléchargements longs / foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- §dlNotif — Android 14+ (API 34) exige de déclarer le TYPE de service de
         premier plan. `dataSync` : le service ne fait que garder le processus
         vivant et afficher une progression, il ne diffuse ni ne lit de média. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- §castSend — Service de premier plan `mediaPlayback` qui garde la
         session Chromecast (socket tenu par Dart) vivante en arrière-plan.
         Déjà déclarée par le manifeste du paquet vendoré (fusionné) ; répétée
         ici pour que la dépendance soit lisible sans ouvrir le paquet. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- §nowPlaying — Android 13+ : sans elle, la notification de lecture
         (écran verrouillé, casque) n'est jamais affichée. Demandée à l'exécution
         à la première lecture, jamais au démarrage. Réutilisée par §dlNotif
         (demandée alors au premier téléchargement). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Installation d'APK (mise à jour in-app) — Android 8+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- §dpadBack — `enableOnBackInvokedCallback="false"` ci-dessous : le Back
         prédictif est DÉSACTIVÉ explicitement. Avec targetSdk 36 il serait actif
         par défaut sur Android 15+ (OnBackInvokedCallback), alors que Fire OS
         (Android 9/11) reste sur `onBackPressed` → deux comportements de Retour
         selon la box. On fige l'ancien chemin pour n'en avoir qu'un seul
         partout — cf. `AppBack` (lib/core/navigation/focus_route_memory.dart). -->
    <application
        android:label="AetherStream"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:banner="@drawable/banner_tv"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false">

        <!-- §pipPhone — `configChanges` couvre déjà screenSize|smallestScreenSize
             |screenLayout : c'est ce qui évite que l'activité soit RECRÉÉE (donc
             le lecteur remis à zéro) à l'entrée en PiP. ⚠️ `resizeableActivity`
             n'est volontairement PAS déclaré : sa valeur par défaut est déjà
             `true` pour targetSdk >= 24, et l'app porte aussi le lanceur TV
             (LEANBACK_LAUNCHER) — le fixer explicitement changerait le
             comportement multi-fenêtre sur des box qui n'en ont pas besoin. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Launcher smartphone/tablette -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Launcher Android TV — affiche l'app dans la grille TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §dlNotif — Service de premier plan qui garde le téléchargement en
             vie et affiche sa progression. `exported="false"` : jamais appelé
             par une autre app. -->
        <service
            android:name=".AetherDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- §castSend — Service de premier plan de la diffusion Chromecast :
             notification « Diffusion sur … » + Pause / Arrêter, et surtout le
             processus (donc la session Cast) gardé vivant en arrière-plan. -->
        <service
            android:name=".AetherCastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- FileProvider pour partager l'APK de mise à jour (Android 7+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
