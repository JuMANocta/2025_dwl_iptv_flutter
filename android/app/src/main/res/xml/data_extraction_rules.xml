<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.
  Backup/transfert d'app désactivés pour éviter toute fuite des credentials IPTV
  + clé TMDB stockés dans flutter_secure_storage / SharedPreferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
